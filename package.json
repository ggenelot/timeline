{
  "name": "timeline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "supabase:start": "npx supabase start",
    "supabase:stop": "npx supabase stop",
    "supabase:db:reset": "npx supabase db reset",
    "supabase:db:push": "npx supabase db push",
    "supabase:migration:new": "npx supabase migration new",
    "supabase:db:seed": "npx supabase db seed",
    "db:seed:demo": "node scripts/seed-demo-data.mjs",
    "demo:create-test-accounts": "node scripts/create-test-accounts.mjs",
    "demo:setup": "npm run supabase:db:reset && npm run demo:create-test-accounts && npm run supabase:db:seed && npm run db:seed:demo",
    "demo:screenshots": "node scripts/demo-screenshots.mjs",
    "test:e2e:slack-sso": "playwright test tests/e2e/slack-sso.spec.ts",
    "diagnose:slack-oauth": "node scripts/diagnose-slack-oauth.mjs",
    "test": "npm run typecheck && npm run test:e2e:p0",
