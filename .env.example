# =============================================================================
# Timeline — Variables d'environnement
# =============================================================================
# Copier ce fichier en .env.local et renseigner les valeurs.
#
#   cp .env.example .env.local
#
# Les variables NEXT_PUBLIC_* sont exposées dans le navigateur.
# Ne jamais mettre de secret dans une variable NEXT_PUBLIC_*.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — OBLIGATOIRE
# -----------------------------------------------------------------------------

# URL du projet Supabase.
# En local (après `npm run supabase:start`) : http://127.0.0.1:54321
# En production : https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Clé publique (anon key) — safe à exposer côté client.
# Récupérée dans : Supabase Dashboard → Settings → API → Project API keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clé de service (service_role key) — accès admin complet, contourne les RLS.
# NE JAMAIS exposer côté client ni commiter dans Git.
# Récupérée dans : Supabase Dashboard → Settings → API → Project API keys
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key


# -----------------------------------------------------------------------------
# Application — OBLIGATOIRE
# -----------------------------------------------------------------------------

# URL de base de l'application (sans slash final).
# En local : http://localhost:3000
# En production : https://monapp.vercel.app
APP_BASE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Slack — Bot V1 (optionnel)
# -----------------------------------------------------------------------------
# Requis pour : création de canaux privés mission, invitations bénévoles, DMs.
# L'application fonctionne sans ces variables si Slack n'est pas utilisé.

# Token du bot Slack (format : xoxb-...).
# Récupéré dans : api.slack.com/apps → votre app → OAuth & Permissions → Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Secret de signature Slack — vérifie l'authenticité des requêtes entrantes (slash commands).
# Récupéré dans : api.slack.com/apps → votre app → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=your-signing-secret


# -----------------------------------------------------------------------------
# Slack — OAuth (optionnel)
# -----------------------------------------------------------------------------
# Requis pour : liaison de compte (connect) et connexion SSO (auth V2).

# ID client OAuth Slack.
# Récupéré dans : api.slack.com/apps → votre app → Basic Information → App Credentials
SLACK_CLIENT_ID=your-client-id

# Secret client OAuth Slack. NE JAMAIS exposer côté client.
SLACK_CLIENT_SECRET=your-client-secret

# URI de callback pour la liaison de compte (flux /api/slack/connect).
# Doit être déclarée dans : api.slack.com/apps → votre app → OAuth & Permissions → Redirect URLs
SLACK_OAUTH_REDIRECT_URI=http://localhost:3000/api/slack/connect/callback

# URI de callback pour la connexion SSO (flux /api/auth/slack).
# Doit être déclarée dans : api.slack.com/apps → votre app → OAuth & Permissions → Redirect URLs
SLACK_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/slack/callback

# ID du workspace Slack (optionnel).
# Si renseigné, restreint la connexion Slack à ce seul workspace.
# Format : T0XXXXXXX
# SLACK_TEAM_ID=T0XXXXXXX

# Domaine du workspace Slack (optionnel, utilisé pour les redirections).
# Exemple : monorganisation (sans .slack.com)
# SLACK_TEAM_DOMAIN=monorganisation


# -----------------------------------------------------------------------------
# Tests E2E — Playwright (optionnel)
# -----------------------------------------------------------------------------

# URL de base pour les tests E2E.
# Par défaut : APP_BASE_URL, ou http://localhost:3000 si non défini.
# E2E_BASE_URL=http://localhost:3000

# Mot de passe des comptes de test (admin@pcivile.test, etc.).
# Par défaut : protec1234
# E2E_TEST_PASSWORD=protec1234

# Compte Slack utilisé dans les tests SSO.
# SLACK_TEST_EMAIL=test@example.com
# SLACK_TEST_PASSWORD=your-slack-test-password
# SLACK_TEST_WORKSPACE_URL=https://your-workspace.slack.com


# -----------------------------------------------------------------------------
# Script de données de démo (optionnel)
# -----------------------------------------------------------------------------
# Voir `npm run db:seed:demo` (README > "Peupler la base avec des données de démo").

# Mot de passe des comptes de démo générés. Par défaut : protec1234
# DEMO_SEED_PASSWORD=protec1234

# Nombre de comptes générés par rôle. Valeurs par défaut : 30 / 4 / 2.
# DEMO_SEED_VOLUNTEER_COUNT=30
# DEMO_SEED_RESPONSABLE_COUNT=4
# DEMO_SEED_ADMIN_COUNT=2

# Force l'exécution du script même si l'URL Supabase ne ressemble pas à du local.
# DEMO_SEED_FORCE=1


# -----------------------------------------------------------------------------
# Import de missions (optionnel)
# -----------------------------------------------------------------------------

# URL publique d'un Google Sheet contenant des missions à importer.
# Le sheet doit être accessible en lecture publique (partage "Tout le monde avec le lien").
# GOOGLE_MISSIONS_SHEET_PUBLIC_URL=https://docs.google.com/spreadsheets/d/...
